<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:webview="clr-namespace:Avalonia.Controls;assembly=Avalonia.Controls.WebView"
        x:Class="BpmnAnalyzer.Desktop.Views.MainWindow"
        Title="BpmnAnalyzer Studio — Analyst Workspace" 
        Width="1400" Height="900"
        Background="#0f1419">
    
    <Grid>
        <!-- Нативный WebView рендерит полноценный интерфейс AnalystPad с темной темой и bpmn-js -->
        <webview:NativeWebView x:Name="BpmnWebView" />
    </Grid>
</Window>