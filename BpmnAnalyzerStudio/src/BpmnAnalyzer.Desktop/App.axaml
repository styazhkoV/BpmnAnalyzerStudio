<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="BpmnAnalyzer.Desktop.App"
             RequestedThemeVariant="Light">

    <Application.Styles>
        <FluentTheme />

        <!-- Базовые глобальные стили контролов -->
        <Style Selector="Button">
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="Padding" Value="10,6"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>

        <Style Selector="TextBox">
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderColor}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="8"/>
        </Style>

        <Style Selector="ListBox">
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderColor}"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>
    </Application.Styles>

    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.ThemeDictionaries>
                <!-- Светлая тема -->
                <ResourceDictionary x:Key="Light">
                    <SolidColorBrush x:Key="PrimaryColor">#2563EB</SolidColorBrush>
                    <SolidColorBrush x:Key="PrimaryHoverColor">#1D4ED8</SolidColorBrush>
                    <SolidColorBrush x:Key="SuccessColor">#059669</SolidColorBrush>
                    <SolidColorBrush x:Key="DangerColor">#DC2626</SolidColorBrush>
                    <SolidColorBrush x:Key="BgAppColor">#F3F4F6</SolidColorBrush>
                    <SolidColorBrush x:Key="BgCardColor">#FFFFFF</SolidColorBrush>
                    <SolidColorBrush x:Key="BorderColor">#E5E7EB</SolidColorBrush>
                    <SolidColorBrush x:Key="TextPrimary">#1F2937</SolidColorBrush>
                    <SolidColorBrush x:Key="TextSecondary">#6B7280</SolidColorBrush>
                </ResourceDictionary>

                <!-- Темная тема -->
                <ResourceDictionary x:Key="Dark">
                    <SolidColorBrush x:Key="PrimaryColor">#3B82F6</SolidColorBrush>
                    <SolidColorBrush x:Key="PrimaryHoverColor">#60A5FA</SolidColorBrush>
                    <SolidColorBrush x:Key="SuccessColor">#10B981</SolidColorBrush>
                    <SolidColorBrush x:Key="DangerColor">#EF4444</SolidColorBrush>
                    <SolidColorBrush x:Key="BgAppColor">#111827</SolidColorBrush>
                    <SolidColorBrush x:Key="BgCardColor">#1F2937</SolidColorBrush>
                    <SolidColorBrush x:Key="BorderColor">#374151</SolidColorBrush>
                    <SolidColorBrush x:Key="TextPrimary">#F9FAFB</SolidColorBrush>
                    <SolidColorBrush x:Key="TextSecondary">#9CA3AF</SolidColorBrush>
                </ResourceDictionary>
            </ResourceDictionary.ThemeDictionaries>
        </ResourceDictionary>
    </Application.Resources>
</Application>